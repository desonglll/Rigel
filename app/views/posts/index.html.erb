<% content_for :title, "Posts" %>

<div class="flex gap-6 mb-8 text-base">
  <%= link_to "New post", new_post_path %>
  <% if user_signed_in? %>
    <%= link_to "My Drafts", drafts_posts_path %>
  <% end %>
</div>

<div id="posts">
  <% @posts.each do |post| %>
    <%= render 'post_card', post: post %>
  <% end %>
</div>

<div class="py-8 flex justify-center">
  <%= paginate @posts %>
</div>
