<% if notice %>
  <p class="text-sm text-[#6B7280] py-2 mb-4 border-b border-[#F3F4F6]"><%= notice %></p>
<% end %>

<% unless @post.published? %>
  <p class="text-sm text-[#6B7280] py-2 mb-4 border-b border-[#F3F4F6]">This is a draft post.</p>
<% end %>

<%= render @post %>

<div class="py-8 border-t border-[#F3F4F6] flex gap-6 text-base">
  <% if user_signed_in? && current_user == @post.author %>
    <%= link_to "Edit", edit_post_path(@post) %>
  <% end %>
  <%= link_to "Back", posts_path %>
  <% if user_signed_in? && current_user == @post.author %>
    <%= button_to "Delete", @post, method: :delete, class: "text-[#6B7280] hover:text-[#2563EB] cursor-pointer" %>
  <% end %>
</div>

<%= render partial: "comments/comments", locals: { commentable: @post } %>
