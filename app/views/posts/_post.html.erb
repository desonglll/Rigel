<article id="<%= dom_id post %>" class="container mx-auto py-8">
  <h1 class="text-2xl font-bold mb-2"><%= post.title %></h1>
  <p class="text-sm mb-6"><%= post.author.user_name %> · <time><%= post.created_at.strftime("%Y-%m-%d") %></time></p>
  <div class="leading-relaxed">
    <%= post.content %>
  </div>
</article>
