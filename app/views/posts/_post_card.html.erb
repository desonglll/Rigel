<article id="<%= dom_id post %>" class="py-8 border-b border-[#F3F4F6]">
  <h3 class="text-xl font-bold mb-1"><%= link_to post.title, post, class: "text-black hover:text-[#2563EB]" %></h3>
  <div class="text-sm text-[#6B7280]">
    <%= post.author.user_name %> ·
    <time><%= post.created_at.strftime("%Y-%m-%d") %></time>
  </div>
</article>
