<%= form_with(model: post, class: "py-8 flex flex-col gap-6") do |form| %>
  <% if post.errors.any? %>
    <div class="text-sm border-b border-[#F3F4F6] py-4">
      <h2 class="font-bold mb-2"><%= pluralize(post.errors.count, "error") %> prohibited this post from being
        saved:</h2>
      <ul class="list-disc list-inside text-[#6B7280]">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col gap-2">
    <%= form.label :title, class: "text-sm text-[#6B7280]" %>
    <%= form.text_field :title, class: "border border-[#F3F4F6] px-3 py-2 text-base", style: "border-radius:0" %>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.label :content, class: "text-sm text-[#6B7280]" %>
    <%= form.rich_text_area :content, class: "border border-[#F3F4F6]", style: "border-radius:0" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.check_box :published %>
    <%= form.label :published, class: "text-sm text-[#6B7280]" %>
  </div>

  <div class="pt-4 border-t border-[#F3F4F6]">
    <%= form.submit class: "text-[#2563EB] cursor-pointer bg-transparent border-0 text-base px-0 py-0", style: "border-radius:0" %>
  </div>
<% end %>
